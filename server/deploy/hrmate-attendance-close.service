[Unit]
Description=HRMate daily attendance close
After=network.target hrmate.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/hrmate/server
EnvironmentFile=/etc/hrmate.env
Environment=PATH=/opt/node20/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/opt/node20/bin/npm run attendance:close

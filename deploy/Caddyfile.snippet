# ============================================================
# Pulse HR - add this block to /etc/caddy/Caddyfile
# (keep the existing flavorflow.duckdns.org block untouched)
# ============================================================

pulsehr1.duckdns.org {
	# Pulse HR backend runs on port 4100 to avoid conflict with
	# FlavorFlow ERP which is already using port 4000.
	reverse_proxy 127.0.0.1:4100

	encode gzip

	# Basic security headers
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Allow attendance selfies / uploads up to 10 MB
	request_body {
		max_size 10MB
	}
}

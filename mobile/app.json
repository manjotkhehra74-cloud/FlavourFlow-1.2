{
  "expo": {
    "name": "Pulse HR",
    "slug": "pulsehr",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#6D28D9",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pulsehr.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to take a selfie while marking attendance.",
        "NSLocationWhenInUseUsageDescription": "Used to geo-tag your attendance punch.",
        "NSFaceIDUsageDescription": "Used to verify your identity before marking attendance."
      }
    },
    "android": {
      "package": "com.pulsehr.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6D28D9"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Pulse HR to use your location for attendance."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6D28D9"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Pulse HR to use Face ID / fingerprint to securely punch attendance."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://pulsehr1.duckdns.org/api"
    }
  }
}
